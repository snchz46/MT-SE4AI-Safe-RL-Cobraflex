%% Camera control loop (track 'E') — end-to-end front-camera + safety cage.
%% Canonical STRUCTURE source (this file). The PNG shipped in the manuscript is
%% the laid-out house-style version rendered from the sibling SVG — keep the two
%% in sync when the structure changes:
%%   etrack_camera_control_loop.svg  ->  etrack_camera_control_loop.png  (1360x1180)
%%   chrome --headless --no-sandbox --hide-scrollbars --force-device-scale-factor=1 \
%%          --window-size=1360,1180 --screenshot=etrack_camera_control_loop.png \
%%          file://$PWD/etrack_camera_control_loop.svg
%% A plain mermaid render also works for drafts (loses the legend and the layout):
%%   grep -v '^%%' etrack_camera_control_loop.mmd > /tmp/f.mmd && mmdc -i /tmp/f.mmd -o out.png -b transparent -w 1600
%% (mmdc = mermaid-cli; mermaid v11 rejects the leading %% comment block, hence the grep)
%%
%% One Gazebo camera frame is degraded once, then split to two PARALLEL
%% consumers: the deterministic CV lane estimator that feeds the safety cage
%% (teal), and the downsampled image stack that feeds the CNN policy (purple).
%% Both meet at the cage (coral); its safe action drives /cmd_vel and steps the
%% sim, closing the loop. Ground truth is the sim-only reward/metrics oracle
%% (not shown) — never an input to the policy or the cage (D-43).
%%
%% Action space: the raw action is 2-D (steer + throttle) on the current
%% steer_throttle map (D-50/D-59; cap 0.22 m/s, D-66). The frozen 1-D E-main
%% is the same loop with the throttle component held at fixed_speed (D-49);
%% the cage contract is identical in both cases.

flowchart TD
    GZ["Gazebo + Lane Cam<br/>IMX219 mirror &middot; 640&times;360"]
    DEG["Degradation injector<br/>DR draw or scenario stressor"]
    CV["CV lane estimator<br/>deterministic &middot; D-43"]
    DS["Downsample 84&times;84<br/>grayscale &middot; frame stack &times;4"]
    SUP["Perception supervisor<br/>SR-013 / SR-014 checks"]
    CNN["CNN policy<br/>PPO &middot; CnnPolicy<br/>2-D action head"]
    CAGE["Safety cage .step()<br/>ordered 6-rule chain"]
    CMD["safe_action &rarr; /cmd_vel<br/>Twist: linear, angular.z"]
    STEP["Gazebo step (0.10 s)<br/>advance one control cycle"]

    GZ -- "camera frame" --> DEG
    DEG -- "one native frame &rarr; both consumers &middot; D-43" --> CV
    DEG --> DS
    CV --> SUP
    DS --> CNN
    SUP -- "cage State" --> CAGE
    CNN -- "raw_action: steer + throttle<br/>(1-D E-main: steer, fixed speed)" --> CAGE
    CAGE -- "safe_action, emergency" --> CMD
    CMD --> STEP
    STEP -- "next control cycle" --> GZ

    classDef perception fill:#E1F5EE,stroke:#0F6E56,color:#04342C,stroke-width:1.2px;
    classDef policy     fill:#EEEDFE,stroke:#534AB7,color:#26215C,stroke-width:1.2px;
    classDef cage       fill:#FAECE7,stroke:#993C1D,color:#4A1B0C,stroke-width:1.2px;
    classDef sim        fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A,stroke-width:1.2px;
    class CV,SUP perception;
    class DS,CNN policy;
    class CAGE cage;
    class GZ,DEG,CMD,STEP sim;
