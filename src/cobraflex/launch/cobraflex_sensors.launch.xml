<launch>
    <!-- Layer 2 — every sensor the platform carries.

         The lane camera (Jetson CSI) joins the lidar and the ZED here so a
         bring-up is three commands and no sensor is left to a side script:

             1. cobraflex_bringup.launch.xml   description + ROS->JSON driver
             2. cobraflex_sensors.launch.xml   lidar + ZED + LANE CAMERA + ekf
             3. a Layer-3 controller (e.g. cobraflex_rl deploy_cobraflex.launch.py)

         There is deliberately NO separate "RL-only sensors" launch. The ZED
         include below carries three settings that are load-bearing for the TF
         tree and for the cage's speed input, each with the reasoning attached;
         a second copy of that block is a second place for them to drift, and
         only ONE node here is unused by the RL chain — the lidar, which is one
         argument away (`use_lidar:=false`). The CPU that matters is INSIDE
         `zed_node` (51.1 % of a core, docs/17 §8.6) and the lever for it is
         `config/zed_deploy_overrides.yaml`, not a different launch file.

         Consequences of owning the camera here, both load-bearing:

         * `deploy_cobraflex.launch.py` defaults `camera:=false` — it attaches to
           `camera/image_raw_lane` instead of opening the device a second time.
           nvarguscamerasrc does not share a sensor, so the second opener simply
           fails to start.
         * `cobraflex_lane_keeper.launch.py` (the classical CV controller) opens
           the CSI device *inside* `lane_keeper_node`. Run it with
           `use_lane_camera:=false`, or not at all — it also commands /cmd_vel.
    -->

    <arg name="use_lane_camera" default="true"/>
    <arg name="lane_camera_sensor_id" default="0"/>
    <arg name="lane_camera_flip_method" default="0"/>
    <arg name="lane_camera_topic" default="camera/image_raw_lane"/>
    <!-- Sensor framerate, 30 rather than csi_camera_node's own default of 60.
         Measured on the car 26.08.2026 with the real two-subscriber topology
         (docs/17 §8.6, and the table in csi_camera_node.gstreamer_pipeline):
         capturing at 60 cost 38 % of a core MORE than capturing at 30 and
         delivered a WORSE rate (15.2 vs 19.0 Hz) — the sensor pipeline competed
         for CPU with the node reading it, and two of every three converted
         frames were discarded anyway. nvargus-daemon alone went 36.3 % -> 20.2 %.
         Nothing about the PUBLISHED stream changes (still 640x360 at rate_hz),
         so §1b's sim/hardware symmetry is untouched.
         Set here and not as the node default on purpose: csi_camera_node's
         pipeline builder is asserted byte-identical to lane_keeper_node's, and
         the RL deployment has no business moving the classical controller. -->
    <arg name="lane_camera_capture_fps" default="30"/>
    <!-- Override de parámetros de la ZED para una corrida de despliegue. Vacío
         = config de fábrica del wrapper (con cierre de bucle y detección de
         objetos activos). Ver el fichero para el porqué de cada línea. -->
    <arg name="zed_overrides"
         default="$(find-pkg-share cobraflex)/config/zed_deploy_overrides.yaml"/>
    <!-- El lidar NO lo consume nadie en la cadena RL. Layer 3 usa la cámara CSI
         y `/odometry/filtered`; ninguna regla de la cage (C-01..C-06) lee un
         LaserScan, y `ekf_hw.yaml` fusiona solo `/zed/zed_node/odom`. Lo usa
         `cobraflex_automatic.launch.xml` (evitación por lidar), que es otro
         controlador de Layer 3 — de ahí que el default siga siendo `true` y
         esto sea un argumento y no un borrado.
         `use_lidar:=false` en una corrida RL para no pagar el driver serie ni
         el TF de `lidar_link`. AHORRO NO MEDIDO: el A2M8 no aparece en la tabla
         de carga de docs/17 §8.6 (que lista todo por encima del 9 % de un
         núcleo), así que está por debajo de eso. Es headroom barato, no la
         solución al bucle de control. -->
    <arg name="use_lidar" default="true"/>

    <!-- ================= Lidar SLLIDAR A2M8 ================= -->
    <group if="$(var use_lidar)">
        <include file="$(find-pkg-share sllidar_ros2)/launch/sllidar_a2m8_launch.py">
            <arg name="frame_id" value="lidar_link"/>
        </include>
    </group>

    <!-- ================= ZED Camera (ZED Mini) ================= -->
    <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
        <arg name="camera_model" value="zedm"/>
        <arg name="camera_name" value="zed"/>
        <!-- OFF: my_robot_basic.urdf instantiates the zed_camera macro itself, so
             the wrapper must not publish a competing description. -->
        <arg name="publish_urdf" value="false"/>
        <!-- OFF, and load-bearing: left at its default the wrapper broadcasts
             odom -> zed_camera_link, which would collide with the ekf's
             odom -> base_footprint (two publishers rooted at odom, and
             zed_camera_link reachable by two paths). The ekf is the single owner
             of that edge; the ZED contributes only the /zed/zed_node/odom TOPIC,
             which keeps publishing because it is gated on positional tracking,
             not on publish_tf. -->
        <arg name="publish_tf" value="false"/>

        <!-- ZED IMU -->
        <arg name="publish_imu_tf" value="true"/>

        <!-- ZED Mapping -->
        <arg name="publish_map_tf" value="false"/>
        <!-- NO-OP, kept as documentation of intent: zed_camera.launch.py does not
             declare this argument, and ROS 2 silently turns undeclared launch
             arguments into LaunchConfigurations nobody reads. The value actually
             in force is `true`, from the wrapper's own config/common_stereo.yaml.
             Worth revisiting: on loop closure the ZED JUMPS its odometry, and that
             jump enters the ekf as an absolute pose with ~1e-5 covariance and
             odom0_differential:false, so the filter follows it hard and emits a
             spurious velocity spike straight into the cage's speed. REP-105 wants
             odom continuous and jumps confined to map. To actually change it, edit
             the wrapper YAML or pass ros_params_override_path. -->
        <arg name="reset_odom_with_loop_closure" value="true"/>

        <!-- Lo anterior es un NO-OP (el wrapper no declara ese argumento). Lo
             que SÍ tiene efecto es este fichero, que el wrapper aplica encima de
             su propia config. Ahí se apaga el cierre de bucle — el mecanismo que
             el comentario de arriba lleva señalando desde el 06.08 y que quedó
             MEDIDO el 26.08 (docs/17 §8.7) — y de paso la detección de objetos y
             las nubes de puntos, que no tienen suscriptores en esta cadena.
             Pasar `zed_overrides:=''` lo desactiva y deja la config de fábrica. -->
        <arg name="ros_params_override_path" value="$(var zed_overrides)"/>
    </include>

    <!-- ============ Lane camera (Jetson CSI, IMX219-160) ============
         The camera the RL policy and the D-43 cage estimator BOTH read. Frame
         geometry is deliberately not exposed as an argument: csi_camera_node
         defaults 640x360 / 90 deg / 20 Hz from `camera_geometry`, and any other
         size mis-projects every ey/epsi the cage acts on. -->
    <node pkg="cobraflex_rl" exec="csi_camera_node" name="csi_camera_node"
          output="screen" if="$(var use_lane_camera)">
        <param name="image_topic" value="$(var lane_camera_topic)"/>
        <param name="sensor_id" value="$(var lane_camera_sensor_id)"/>
        <param name="flip_method" value="$(var lane_camera_flip_method)"/>
        <param name="capture_fps" value="$(var lane_camera_capture_fps)"/>
    </node>

    <!-- ================= State estimation =================
         Fuses the ZED visual odometry into /odometry/filtered and owns the
         odom -> base_footprint TF on hardware (see config/ekf_hw.yaml). This is
         also the ONLY source of speed for the cage: cv_lane_estimator_node reads
         /odometry/filtered, and without it C-03/C-04 stay inert. -->
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
        <param from="$(find-pkg-share cobraflex)/config/ekf_hw.yaml"/>
    </node>

</launch>
