<?xml version="1.0"?>
<robot name="cobraflex_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="$(find cobraflex)/urdf/robot.gazebo" />
    <xacro:include filename="inertial_macros.xacro" />
    <xacro:include filename="$(find cobraflex)/urdf/zed_macro.urdf.xacro" />
    
    <xacro:property name="chassis_length" value="0.228" />
    <xacro:property name="chassis_width" value="0.130" />
    <xacro:property name="chassis_height" value="0.060" />
    <!-- Mass budget = the MEASURED 3.5 kg total (CobraFlex 1:14
         Parameters_0813, 13.08.2026), distributed from the itemised bill of
         materials the platform team supplied on 17.08.2026. Previous budget
         summed to 6.59 kg (1.88x too heavy), and the itemisation shows the
         WHOLE overshoot sat in this one chassis placeholder:

           body_link 0.8928 = PLA shells 0.2778 (measured: 91.3 g bottom /
                              118.5 g centre / 68 g top cover) + powerbank 0.550
                              (XT-27000DC datasheet; the team quoted 500 g) +
                              ZED Mini 0.060 + lane cam ~0.005
           lidar     0.190   = manufacturer (RPLIDAR A2M4) - unchanged
           wheel     0.1 x4  = NOT MEASURED, left at the original value
           chassis   2.0172  = remainder: frame + 4 motors + driver board +
                               motor battery + Jetson Orin Nano DevKit (0.175,
                               NVIDIA SP-11324-001 p33; chassis placement
                               CONFIRMED by the platform team, not assumed)
                               + wiring + fasteners

         The ZED Mini's 60 g is folded in here because zed_macro.urdf.xacro
         declares no <inertial> at all. Composite CoG sat 0.0566 m above
         base_link while body_link used the inertial_box macro; since that link
         was replaced by the CAD measurement (see its comment below) it sits at
         0.0534 m (0.0906 m above ground).
         NOTE: every frozen Gazebo campaign (F4, GE4-V2, campaign_2d_ppo550k)
         was executed with the 6.59 kg budget. Re-running them at HEAD will not
         reproduce them byte-for-byte; the runs are pinned by git commit. -->
    <xacro:property name="chassis_mass" value="2.0172" />

    <xacro:property name="body_length" value="0.228" />
    <xacro:property name="body_width" value="0.180" />
    <xacro:property name="body_height" value="0.100" />
    <xacro:property name="body_mass" value="0.8928" />
    
    <xacro:property name="wheel_radius" value="0.03725" /> 
    <xacro:property name="wheel_width" value="0.02" />
    
    <xacro:property name="wheel_off_x" value="0.060" /> 
    <xacro:property name="wheel_off_y" value="${(chassis_width/2) + (wheel_width/2) + 0.002}" /> 

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
            <geometry>
                <mesh filename="file://$(find cobraflex)/meshes/cobraflex_chassis.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}"/> 
    </joint>

    <link name="body_link">
        <visual>
            <origin xyz="0 -0.015 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find cobraflex)/meshes/cobraflex_body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="grey" />
        </visual>
                <collision>
            <origin xyz="0 0 ${body_height/2 + wheel_radius}" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>

        <!-- ==== body_link inertia is MEASURED, not macro-derived. Do not
             restore inertial_box here. The box smears body_mass uniformly
             through 0.228 x 0.180 x 0.100, but the real deck is dominated by
             the 550 g powerbank sitting compact and low in the centre shell,
             so the box overstates every moment by 35-54 %:

                        macro          measured
                 ixx    0.00315456     0.00206253    -34.6 %
                 iyy    0.00461161     0.00210198    -54.4 %
                 izz    0.00627817     0.00359719    -42.7 %

             Source is an Inventor assembly of the built car with every
             component at its weighed density (body composite 0.908 g/cm3; the
             PLA shells at the 0.539 g/cm3 that reproduces their measured
             277.8 g). The tensor is about the link CoG, scaled from the CAD
             mass 898.7 g to body_mass. Unlike the supplied tensor rejected in
             docs/08, this is not our own box read back out of a third-party
             tool - it is an independent model that DISAGREES with the box.

             The CoG also sits 12.6 mm below the box centre: the CAD puts it
             52.6 mm under the lidar, which lidar_joint fixes at 0.090 - hence
             the 0.037415 origin instead of body_height/2.

             The CAD reports ixz = 1.26e-04 (6 % of ixx: the sensor mast is
             forward and high, the powerbank low). Left at zero until the CAD's
             +X direction is confirmed - the macro cannot express it anyway,
             and a sign error there couples pitch the wrong way, which is worse
             than omitting the term.

             base_link, the wheels and the lidar were checked against the same
             assembly and all three land within 5-6 % of their macro values, so
             they keep the macros. The CAD's own chassis mass split is NOT
             usable: its composite density is 3.25 g/cm3, i.e. still placeholder
             materials, and it attributed 302 g to each wheel - the official
             Waveshare wheel file is 87.14 cm3, so 100 g implies 1.148 g/cm3,
             which is exactly right for rubber on a plastic hub. That is why
             only this one link changed.

             NOTE: like the 6.59 -> 3.5 kg correction above, this shifts the
             dynamics again. Every frozen campaign predates it; the runs stay
             pinned by git commit. See docs/14 section 2.2. -->
        <inertial>
            <origin xyz="0 0 0.037415" rpy="0 0 0"/>
            <mass value="${body_mass}" />
            <inertia ixx="0.00206253" ixy="0.0" ixz="0.0"
                     iyy="0.00210198" iyz="0.0"
                     izz="0.00359719" />
        </inertial>
    </link>

    <joint name="body_joint" type="fixed">
        <parent link="base_link"/>
        <child link="body_link"/>
        <origin xyz="0 0 ${body_height/2 + chassis_height/2 - 0.01}"/> 
    </joint>

    <xacro:macro name="left_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} 0" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
                <geometry>
                    <mesh filename="file://$(find cobraflex)/meshes/cobraflex_wheel.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="right_wheel_link" params="prefix x_location y_location">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x_location} ${y_location} 0" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <mesh filename="file://$(find cobraflex)/meshes/cobraflex_wheel.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:left_wheel_link prefix="front_left" x_location="${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="front_right" x_location="${wheel_off_x}" y_location="-${wheel_off_y}" />
    
    <xacro:left_wheel_link prefix="rear_left" x_location="-${wheel_off_x}" y_location="${wheel_off_y}" />
    <xacro:right_wheel_link prefix="rear_right" x_location="-${wheel_off_x}" y_location="-${wheel_off_y}" />


    <gazebo reference="base_footprint">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    
    <gazebo reference="base_link">
        <material name="grey" />
    </gazebo>

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 -0.03" rpy="${pi/2} 0 ${pi}"/>
            <geometry>
                <mesh filename="file://$(find cobraflex)/meshes/rplidar-a2m4-r1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
                <material name="blue" />
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.04" radius="0.0375"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.190" length="0.04" radius="0.0375">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="body_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 ${body_height/2 + 0.04}" rpy="0 0 0"/>
    </joint>

    <xacro:zed_camera name="zedm" model="zedm">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>

    <joint name="zedm_mount_joint" type="fixed">
        <parent link="body_link"/>
        <child link="zedm_camera_link"/>
        <origin xyz="${body_length/2 - 0.0475} 0 ${0.02 - 0.0265/2}" rpy="0 0 0"/>
    </joint>

    <link name="camera_link_lane">
        <visual>
            <origin xyz="0 0 0" rpy="0 -1 0"/>
            <geometry>
                <cylinder radius="0.005" length="0.002"/>
            </geometry>
            <material name="yellow" />
        </visual>
        <collision>
             <geometry>
                <cylinder radius="0.005" length="0.002"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint_lane" type="fixed">
        <parent link="body_link"/>
        <child link="camera_link_lane"/>
        <origin xyz="${body_length/2 + 0.02} 0 -0.03" rpy="0 0 0"/>
    </joint>

    <link name="camera_link_optical_lane"></link>

    <joint name="camera_optical_joint_lane" type="fixed">
        <parent link="camera_link_lane"/>
        <child link="camera_link_optical_lane"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="imu_link" />

    <joint name="imu_joint" type="fixed">
        <origin xyz="${body_length/2 - 0.0475} 0 0.02" rpy="0 0 0" />
        <parent link="body_link"/>
        <child link="imu_link" />
    </joint>

</robot>