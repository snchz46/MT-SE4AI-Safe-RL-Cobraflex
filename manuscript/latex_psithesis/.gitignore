# Vendored fonts are ~4.6 MB of binaries (Roboto + Iosevka SS04), committed on
# purpose so the project builds offline on the compute host. If the repository
# would rather not carry them, uncomment the next line and fetch them with:
#   BASE=https://raw.githubusercontent.com/UBA-PSI/psi-thesis-guide/master/degree-thesis
#   for f in Roboto-{Regular,Bold,Italic,BoldItalic}.otf \
#            iosevka-ss04-{regular,bold,italic,bolditalic}.ttf; do
#     curl -sSL "$BASE/fonts/$f" -o "fonts/$f"
#   done
# fonts/*.otf
# fonts/*.ttf
